{
  // "entryPoints": ["src/docIndex.ts", "src/Graph.ts"],
  "entryPoints": ["src/docIndex.ts"],
  "outputs": [
    {
      "name": "markdown",
      "path": "./docs/public/api/markdown"
    },
    {
      "name": "html",
      "path": "./docs/public/api/html",
      "options": {
        "navigation": {
          "includeGroups": true,
        }
      }
    }
  ],
  "exclude": ["**/__tests__/**", "**/*.test.ts"],
  // Internal support classes reachable via public fields (e.g. graph.editing,
  // and the PluginContext's ui/layout/keyManager) but intentionally not their
  // own doc pages. Listing them here silences "referenced but not included".
  "intentionallyNotExported": [
    "GraphEditingManager",
    "NoteManager",
    "GraphQueryEngine",
    "KeybindingManager",
    "Layout",
    "UIManager",
    "Note",
    "FieldConfig",
    "NodeEditSession",
    "SimulationEdgeDTO",
    "SimulationNodeDTO",
    "Point",
    "ProgressType"
  ],
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "groupOrder": [
    "Classes",
    "Namespaces",
    "*"
  ],
  "includeVersion": true,
  "plugin": [
    "typedoc-plugin-markdown"
  ],
  "tsconfig": "tsconfig.json"
}
