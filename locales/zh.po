msgctxt "physicsFlyout.knob.friction"
msgid "Friction"
msgstr "摩擦力"

#: src/i18n/en/panels.ts:111
msgctxt "physicsFlyout.knob.friction.title"
msgid "How quickly node motion is damped. Higher values calm the layout and settle it faster."
msgstr "节点运动衰减的速度。值越大，布局越快稳定。"

#: src/i18n/en/panels.ts:112
msgctxt "physicsFlyout.knob.centering"
msgid "Centering"
msgstr "居中力"

#: src/i18n/en/panels.ts:113
msgctxt "physicsFlyout.knob.centering.title"
msgid "How strongly the graph is pulled toward the middle of the canvas. Higher values keep disconnected parts in frame."
msgstr "将图拉向画布中心的强度。值越大，越能使不相连的部分保持在画面内。"

