#: src/i18n/en/panels.ts:94
msgctxt "physicsFlyout.spacing.value"
msgid "{count}×"
msgstr "{count}×"

#: src/i18n/en/panels.ts:95
msgctxt "physicsFlyout.simulation"
msgid "Simulation"
msgstr "Simulación"

#: src/i18n/en/panels.ts:96
msgctxt "physicsFlyout.pause.title"
msgid "Pause physics"
msgstr "Pausar física"

#: src/i18n/en/panels.ts:97
msgctxt "physicsFlyout.resume.title"
msgid "Resume physics"
msgstr "Reanudar física"

#: src/i18n/en/panels.ts:98
msgctxt "physicsFlyout.preset.auto"
msgid "Auto"
msgstr "Automático"

#: src/i18n/en/panels.ts:99
msgctxt "physicsFlyout.preset.auto.title"
msgid "Let the layout tune itself from the number of nodes, their size and the canvas — and keep tuning as the graph changes."
msgstr "Ajusta la distribución según la cantidad y el tamaño de los nodos y el lienzo, y sigue ajustándola cuando cambia el grafo."

#: src/i18n/en/panels.ts:100
msgctxt "physicsFlyout.preset.tight"
msgid "Tight"
msgstr "Compacta"

#: src/i18n/en/panels.ts:101
msgctxt "physicsFlyout.preset.tight.title"
msgid "Compact layout with nodes packed closely together."
msgstr "Distribución compacta con nodos muy juntos."

#: src/i18n/en/panels.ts:102
msgctxt "physicsFlyout.preset.loose"
msgid "Loose"
msgstr "Amplia"

#: src/i18n/en/panels.ts:103
msgctxt "physicsFlyout.preset.loose.title"
msgid "Spacious layout with nodes spread further apart."
msgstr "Distribución amplia con nodos más separados."

#: src/i18n/en/panels.ts:104
msgctxt "physicsFlyout.knob.repulsion"
msgid "Repulsion"
msgstr "Repulsión"

#: src/i18n/en/panels.ts:105
msgctxt "physicsFlyout.knob.repulsion.title"
msgid "How strongly nodes push each other apart. Higher values spread the graph out."
msgstr "Fuerza con la que se repelen los nodos. Los valores altos expanden el grafo."

#: src/i18n/en/panels.ts:106
msgctxt "physicsFlyout.knob.linkDistance"
msgid "Link distance"
msgstr "Distancia de enlace"

#: src/i18n/en/panels.ts:107
msgctxt "physicsFlyout.knob.linkDistance.title"
msgid "The resting length of edges, in pixels. Higher values place connected nodes further apart."
msgstr "Longitud de reposo de las aristas en píxeles. Los valores altos separan más los nodos conectados."

#: src/i18n/en/panels.ts:108
msgctxt "physicsFlyout.knob.collisionRadius"
msgid "Collision radius"
msgstr "Radio de colisión"

#: src/i18n/en/panels.ts:109
msgctxt "physicsFlyout.knob.collisionRadius.title"
msgid "The clear space kept around each node to prevent overlap. Higher values keep nodes further apart."
msgstr "Espacio libre alrededor de cada nodo para evitar solapamientos. Los valores altos separan más los nodos."

#: src/i18n/en/panels.ts:110
msgctxt "physicsFlyout.knob.friction"
msgid "Friction"
msgstr "Fricción"

#: src/i18n/en/panels.ts:111
msgctxt "physicsFlyout.knob.friction.title"
msgid "How quickly node motion is damped. Higher values calm the layout and settle it faster."
msgstr "Rapidez con la que se amortigua el movimiento. Los valores altos estabilizan antes la distribución."

#: src/i18n/en/panels.ts:112
msgctxt "physicsFlyout.knob.centering"
msgid "Centering"
msgstr "Centrado"

#: src/i18n/en/panels.ts:113
msgctxt "physicsFlyout.knob.centering.title"
msgid "How strongly the graph is pulled toward the middle of the canvas. Higher values keep disconnected parts in frame."
msgstr "Fuerza que atrae el grafo al centro del lienzo. Los valores altos mantienen a la vista las partes desconectadas."

#: src/i18n/en/panels.ts:114
msgctxt "physicsFlyout.knob.settleTime"
msgid "Settle time"
msgstr "Tiempo de estabilización"

#: src/i18n/en/panels.ts:115
msgctxt "physicsFlyout.knob.settleTime.title"
msgid "How long the layout is given to settle, in seconds. Higher values let large graphs unfold further before they stop."
msgstr "Tiempo en segundos para estabilizar la distribución. Los valores altos permiten que los grafos grandes se desplieguen más antes de detenerse."

