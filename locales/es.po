#: src/i18n/en/panels.ts:87
msgctxt "physicsFlyout.spacing"
msgid "Spacing"
msgstr "Espaciado"

#: src/i18n/en/panels.ts:88
msgctxt "physicsFlyout.spacing.auto"
msgid "Auto"
msgstr "Automático"

#: src/i18n/en/panels.ts:89
msgctxt "physicsFlyout.spacing.auto.title"
msgid "Let the tree work out its own distances from the size of the nodes and the shape of the tree — and keep working them out as the graph changes."
msgstr "Calcula las distancias según el tamaño de los nodos y la forma del árbol, y las ajusta cuando cambia el grafo."

#: src/i18n/en/panels.ts:90
msgctxt "physicsFlyout.spacing.level"
msgid "Level distance"
msgstr "Distancia entre niveles"

#: src/i18n/en/panels.ts:91
msgctxt "physicsFlyout.spacing.level.title"
msgid "How far apart consecutive levels of the tree sit — the gap between rings, in the radial layout."
msgstr "Distancia entre niveles consecutivos del árbol, o entre anillos en la distribución radial."

#: src/i18n/en/panels.ts:92
msgctxt "physicsFlyout.spacing.sibling"
msgid "Sibling distance"
msgstr "Distancia entre hermanos"

#: src/i18n/en/panels.ts:93
msgctxt "physicsFlyout.spacing.sibling.title"
msgid "How far apart nodes on the same level sit. The radial layout spreads a level over the whole circle, so it ignores this one."
msgstr "Distancia entre nodos del mismo nivel. La distribución radial la ignora porque reparte el nivel por todo el círculo."

