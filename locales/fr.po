#: src/i18n/en/panels.ts:87
msgctxt "physicsFlyout.spacing"
msgid "Spacing"
msgstr "Espacement"

#: src/i18n/en/panels.ts:88
msgctxt "physicsFlyout.spacing.auto"
msgid "Auto"
msgstr "Auto"

#: src/i18n/en/panels.ts:89
msgctxt "physicsFlyout.spacing.auto.title"
msgid "Let the tree work out its own distances from the size of the nodes and the shape of the tree — and keep working them out as the graph changes."
msgstr "Laisser l’arbre calculer les distances selon la taille des nœuds et sa forme, puis les recalculer quand le graphe change."

#: src/i18n/en/panels.ts:90
msgctxt "physicsFlyout.spacing.level"
msgid "Level distance"
msgstr "Distance entre niveaux"

#: src/i18n/en/panels.ts:91
msgctxt "physicsFlyout.spacing.level.title"
msgid "How far apart consecutive levels of the tree sit — the gap between rings, in the radial layout."
msgstr "Distance entre deux niveaux consécutifs de l’arbre ; en disposition radiale, écart entre les anneaux."

#: src/i18n/en/panels.ts:92
msgctxt "physicsFlyout.spacing.sibling"
msgid "Sibling distance"
msgstr "Distance entre frères"

#: src/i18n/en/panels.ts:93
msgctxt "physicsFlyout.spacing.sibling.title"
msgid "How far apart nodes on the same level sit. The radial layout spreads a level over the whole circle, so it ignores this one."
msgstr "Distance entre les nœuds d’un même niveau. Ignorée en disposition radiale, qui répartit le niveau sur tout le cercle."

#. Preserve placeholders: {count}
#: src/i18n/en/panels.ts:94
msgctxt "physicsFlyout.spacing.value"
msgid "{count}×"
msgstr "{count}×"

#: src/i18n/en/panels.ts:95
msgctxt "physicsFlyout.simulation"
msgid "Simulation"
msgstr "Simulation"

#: src/i18n/en/panels.ts:96
msgctxt "physicsFlyout.pause.title"
msgid "Pause physics"
msgstr "Suspendre la physique"

#: src/i18n/en/panels.ts:97
msgctxt "physicsFlyout.resume.title"
msgid "Resume physics"
msgstr "Reprendre la physique"

#: src/i18n/en/panels.ts:98
msgctxt "physicsFlyout.preset.auto"
msgid "Auto"
msgstr "Auto"

#: src/i18n/en/panels.ts:99
msgctxt "physicsFlyout.preset.auto.title"
msgid "Let the layout tune itself from the number of nodes, their size and the canvas — and keep tuning as the graph changes."
msgstr "Laisser la disposition s’ajuster au nombre et à la taille des nœuds ainsi qu’au canevas, et se réajuster quand le graphe change."

#: src/i18n/en/panels.ts:100
msgctxt "physicsFlyout.preset.tight"
msgid "Tight"
msgstr "Serrée"

#: src/i18n/en/panels.ts:101
msgctxt "physicsFlyout.preset.tight.title"
msgid "Compact layout with nodes packed closely together."
msgstr "Disposition compacte avec des nœuds rapprochés."

#: src/i18n/en/panels.ts:102
msgctxt "physicsFlyout.preset.loose"
msgid "Loose"
msgstr "Aérée"

#: src/i18n/en/panels.ts:103
msgctxt "physicsFlyout.preset.loose.title"
msgid "Spacious layout with nodes spread further apart."
msgstr "Disposition aérée avec des nœuds plus éloignés."

#: src/i18n/en/panels.ts:104
msgctxt "physicsFlyout.knob.repulsion"
msgid "Repulsion"
msgstr "Répulsion"

#: src/i18n/en/panels.ts:105
msgctxt "physicsFlyout.knob.repulsion.title"
msgid "How strongly nodes push each other apart. Higher values spread the graph out."
msgstr "Force avec laquelle les nœuds se repoussent. Une valeur élevée étale le graphe."

#: src/i18n/en/panels.ts:106
msgctxt "physicsFlyout.knob.linkDistance"
msgid "Link distance"
msgstr "Longueur des liens"

#: src/i18n/en/panels.ts:107
msgctxt "physicsFlyout.knob.linkDistance.title"
msgid "The resting length of edges, in pixels. Higher values place connected nodes further apart."
msgstr "Longueur au repos des arêtes, en pixels. Une valeur élevée éloigne les nœuds reliés."

#: src/i18n/en/panels.ts:108
msgctxt "physicsFlyout.knob.collisionRadius"
msgid "Collision radius"
msgstr "Rayon de collision"

#: src/i18n/en/panels.ts:109
msgctxt "physicsFlyout.knob.collisionRadius.title"
msgid "The clear space kept around each node to prevent overlap. Higher values keep nodes further apart."
msgstr "Espace libre autour de chaque nœud pour éviter les chevauchements. Une valeur élevée éloigne les nœuds."

#: src/i18n/en/panels.ts:110
msgctxt "physicsFlyout.knob.friction"
msgid "Friction"
msgstr "Friction"

#: src/i18n/en/panels.ts:111
msgctxt "physicsFlyout.knob.friction.title"
msgid "How quickly node motion is damped. Higher values calm the layout and settle it faster."
msgstr "Vitesse d’amortissement du mouvement des nœuds. Une valeur élevée stabilise la disposition plus vite."

#: src/i18n/en/panels.ts:112
msgctxt "physicsFlyout.knob.centering"
msgid "Centering"
msgstr "Centrage"

#: src/i18n/en/panels.ts:113
msgctxt "physicsFlyout.knob.centering.title"
msgid "How strongly the graph is pulled toward the middle of the canvas. Higher values keep disconnected parts in frame."
msgstr "Force attirant le graphe vers le centre du canevas. Une valeur élevée garde les parties déconnectées dans le cadre."

#: src/i18n/en/panels.ts:114
msgctxt "physicsFlyout.knob.settleTime"
msgid "Settle time"
msgstr "Temps de stabilisation"

#: src/i18n/en/panels.ts:115
msgctxt "physicsFlyout.knob.settleTime.title"
msgid "How long the layout is given to settle, in seconds. Higher values let large graphs unfold further before they stop."
msgstr "Durée de stabilisation, en secondes. Une valeur élevée laisse les grands graphes se déployer davantage avant l’arrêt."

