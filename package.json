{
  "name": "pivotick",
  "version": "2.0.0",
  "description": "A hackable TypeScript graph visualization library built on D3 force simulations.",
  "keywords": [
    "graph",
    "network",
    "visualization",
    "data-visualization",
    "d3",
    "force-directed",
    "graph-layout",
    "svg",
    "typescript"
  ],
  "license": "MIT",
  "author": "Sami Mokaddem",
  "homepage": "https://pivotick.github.io/Pivotick/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pivotick/Pivotick.git"
  },
  "bugs": {
    "url": "https://github.com/Pivotick/Pivotick/issues"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/pivotick.umd.js",
  "module": "./dist/pivotick.es.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/pivotick.es.js",
      "require": "./dist/pivotick.umd.js",
      "default": "./dist/pivotick.umd.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run clean && tsc && npm run build:es && npm run build:browser && npm run build:worker && npm run build:types",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:es": "vite build --config vite.config.es.js",
    "build:browser": "vite build --config vite.config.browser.js",
    "build:worker": "vite build --config vite.config.worker.js",
    "build:types": "tsc -p tsconfig.types.json && node scripts/strip-style-imports.mjs",
    "preview": "vite preview",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "lint_fix": "eslint --fix 'src/**/*.{ts,tsx}'",
    "gallery:thumbs": "node scripts/capture-thumbnails.mjs",
    "docs:hero": "node scripts/capture-hero.mjs",
    "vitepress:dev": "vitepress dev docs",
    "vitepress:build": "vitepress build docs",
    "vitepress:preview": "vitepress preview docs",
    "typedoc:dev": "typedoc --watch",
    "typedoc:build": "typedoc",
    "docs:build": "npm run typedoc:build && npm run vitepress:build",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:visual:ui": "playwright test --ui",
    "test:visual:headed": "playwright test --headed --workers=1",
    "test:visual:report": "playwright show-report tests/visual/.report",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@playwright/test": "^1.61.1",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-force": "^3.0.10",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.8",
    "@types/lodash.merge": "^4.6.9",
    "@typescript-eslint/eslint-plugin": "^8.34.1",
    "@typescript-eslint/parser": "^8.34.1",
    "esbuild": "^0.25.0",
    "eslint": "^9.29.0",
    "globals": "^16.2.0",
    "sass": "^1.90.0",
    "typedoc-plugin-markdown": "^4.9.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.34.1",
    "vite": "^6.3.5",
    "vitepress": "^2.0.0-alpha.12"
  },
  "dependencies": {
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-hierarchy": "^3.1.2",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "dompurify": "^3.4.7",
    "lodash.merge": "^4.6.2",
    "marked": "^18.0.4"
  }
}
